{
  "agent": {
    "region": "us-east-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log",
            "log_group_name": "/app/{autoscaling_group_name}",
            "log_stream_name": "{instance_id}-{autoscaling_group_name}"
          }
        ]
      },
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/journald/{autoscaling_group_name}",
            "log_stream_name": "{autoscaling_group_name}/{instance_id}"
          }
        ]
      }
    },
    "log_stream_name": "{autoscaling_group_name}"
  }
}
