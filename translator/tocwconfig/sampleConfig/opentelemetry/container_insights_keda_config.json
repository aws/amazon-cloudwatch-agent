{
  "agent": {
    "region": "us-east-1"
  },
  "opentelemetry": {
    "cluster_name": "TestCluster",
    "collect": {
      "container_insights": {
        "collection_interval": 30,
        "role": "cluster",
        "solutions": {
          "karpenter": {
            "enabled": false
          },
          "keda": {
            "enabled": true
          }
        }
      }
    }
  }
}
